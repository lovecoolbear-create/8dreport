    "D4_root_cause": {
      "type": "object",
      "required": [
        "ai_analysis",
        "responsibility_judgment",
        "is_confirmed"
      ],
      "description": "D4 — 根本原因分析（双维度：发生根因 + 流出根因），系统核心推理引擎输出",
      "properties": {
        "ai_analysis": {
          "type": "object",
          "required": [
            "occurrence_cause",
            "escape_cause"
          ],
          "properties": {
            "occurrence_cause": {
              "type": "object",
              "description": "发生根因：为什么缺陷会产生？",
              "required": [
                "summary",
                "why_chain"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "description": "发生根因的一句话总结，如 '供应商该批次纸板边压强度不达标'"
                },
                "why_chain": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/WhyChainStep"
                  },
                  "minItems": 1,
                  "description": "针对'为什么会发生'的 5-Why 推理链"
                }
              }
            },
            "escape_cause": {
              "type": "object",
              "description": "流出根因：为什么缺陷产生后，检验环节没有拦截住？",
              "required": [
                "summary",
                "why_chain"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "description": "流出根因的一句话总结，如 '来料检验未覆盖边压强度项目'"
                },
                "why_chain": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/WhyChainStep"
                  },
                  "minItems": 1,
                  "description": "针对'为什么没拦截住'的 5-Why 推理链"
                }
              }
            },
            "contributing_factors": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ContributingFactor"
              },
              "description": "次要/辅助原因"
            },
            "excluded_causes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ExcludedCause"
              },
              "description": "被排除的可能原因及排除理由"
            },
            "rag_sources_used": {
              "type": "object",
              "properties": {
                "public_kb_docs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/RAGSourceReference"
                  },
                  "description": "引用的公共行业知识库文档"
                },
                "private_kb_docs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/RAGSourceReference"
                  },
                  "description": "引用的企业私有库文档"
                }
              }
            }
          }
        },
        "confirmed": {
          "oneOf": [
            {
              "type": "object",
              "description": "人工确认/修改后的根因分析，结构与 ai_analysis 完全一致",
              "required": [
                "occurrence_cause",
                "escape_cause"
              ],
              "properties": {
                "occurrence_cause": {
                  "type": "object",
                  "required": [
                    "summary",
                    "why_chain"
                  ],
                  "properties": {
                    "summary": {
                      "type": "string"
                    },
                    "why_chain": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/WhyChainStep"
                      },
                      "minItems": 1
                    }
                  }
                },
                "escape_cause": {
                  "type": "object",
                  "required": [
                    "summary",
                    "why_chain"
                  ],
                  "properties": {
                    "summary": {
                      "type": "string"
                    },
                    "why_chain": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/WhyChainStep"
                      },
                      "minItems": 1
                    }
                  }
                },
                "contributing_factors": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ContributingFactor"
                  }
                },
                "excluded_causes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ExcludedCause"
                  }
                },
                "rag_sources_used": {
                  "type": "object",
                  "properties": {
                    "public_kb_docs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/RAGSourceReference"
                      }
                    },
                    "private_kb_docs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/RAGSourceReference"
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "responsibility_judgment": {
          "type": "object",
          "description": "Step 3 责任判定 — AI 建议 + 人工确认",
          "required": [
            "ai_suggestion",
            "confirmed_by_user"
          ],
          "properties": {
            "ai_suggestion": {
              "type": "object",
              "required": [
                "primary_responsibility",
                "primary_rationale",
                "alternatives"
              ],
              "properties": {
                "primary_responsibility": {
                  "type": "string",
                  "enum": [
                    "供应商",
                    "客户方",
                    "设计缺陷",
                    "第三方(物流等)",
                    "多方共担",
                    "不可抗力"
                  ],
                  "description": "AI 建议的主要责任方"
                },
                "primary_rationale": {
                  "type": "string",
                  "description": "判定理由，需引用证据"
                },
                "primary_evidence_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "party",
                      "rationale",
                      "evidence_count",
                      "why_not_recommended"
                    ],
                    "properties": {
                      "party": {
                        "type": "string"
                      },
                      "rationale": {
                        "type": "string"
                      },
                      "evidence_count": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "why_not_recommended": {
                        "type": "string"
                      }
                    }
                  },
                  "description": "AI 列出的备选责任方及其不推荐理由"
                }
              }
            },
            "confirmed_by_user": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "selected_responsibility"
                  ],
                  "properties": {
                    "selected_responsibility": {
                      "type": "string"
                    },
                    "custom_rationale": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "用户手动输入的理由"
                    },
                    "confirmed_by": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "confirmed_at": {
                      "oneOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "用户确认后的责任判定结果，未确认时为 null"
            }
          }
        },
        "is_confirmed": {
          "type": "boolean"
        },
        "confirmed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
