                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Evidence"
                  }
                }
              }
            },
            "where": {
              "type": "object",
              "required": [
                "discovery_location"
              ],
              "properties": {
                "discovery_location": {
                  "type": "string"
                },
                "production_location": {
                  "type": "string",
                  "description": "推测的生产地"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Evidence"
                  }
                }
              }
            },
            "why_initial": {
              "type": "object",
              "properties": {
                "preliminary_hypothesis": {
                  "type": "string",
