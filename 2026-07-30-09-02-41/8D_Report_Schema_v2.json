{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai8d.example.com/schemas/8d-report-v2.json",
  "title": "8D Report — AI 多模态智能 8D 报告生成平台 统一数据结构",
  "description": "所有模块（ETL、推理、渲染、导出）以此 Schema 为唯一数据契约。适用于 FastAPI/Pydantic 校验、Directus 模型生成、TypeScript 类型推导。",
  "type": "object",
  "required": [
    "metadata",
    "source_materials",
    "D1_team",
    "D2_problem_description",
    "D3_containment",
    "D4_root_cause",
    "D5_corrective_actions",
    "D6_verification",
    "D7_preventive_actions",
    "D8_recognition",
    "audit_log"
  ],
  "definitions": {
    "Evidence": {
      "type": "object",
      "required": [
        "source_id",
        "source_type",
        "source_name",
        "excerpt"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "description": "引用 source_materials 中的 id 或 RAG 文档 id"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "email",
            "image",
            "supplementary_doc",
            "rag_public",
            "rag_private"
          ],
          "description": "证据来源类型：rag_public=公共行业知识库, rag_private=企业私有库"
        },
        "source_name": {
          "type": "string",
          "description": "人类可读的来源名称，如 'COA检测报告_批次20260715.pdf 第3页'"
        },
        "excerpt": {
          "type": "string",
          "description": "证据原文摘录"
        },
        "page_or_location": {
          "type": "string",
          "description": "证据在原文中的精确位置"
        },
        "relevance": {
          "type": "string",
          "description": "为什么这条证据支持当前推论"
        },
        "similarity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "仅当 source_type 为 rag_public 或 rag_private 时有值。RAG 检索相似度分数，如 0.89 表示匹配度 89%，用于前端渲染可信度指示器"
        }
      }
    },
    "WhyChainStep": {
      "type": "object",
      "required": [
        "level",
        "question",
        "answer",
        "confidence",
        "evidence"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "description": "5-Why 层级，从 1 开始"
        },
        "question": {
          "type": "string",
          "description": "这一层问的问题，如 '为什么纸箱会塌？'"
        },
        "answer": {
          "type": "string",
          "description": "这一层的答案"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "confirmed",
            "inferred",
            "speculative"
          ],
          "description": "confirmed=有直接证据 | inferred=多证据组合推理 | speculative=无证据纯推测"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          },
          "minItems": 1,
          "description": "支持此推论的证据列表，至少一条"
        },
        "supplementary_request": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "当 confidence=speculative 时，自动生成的补充资料请求清单"
        },
        "cannot_conclude": {
          "type": "boolean",
          "description": "confidence=speculative 时为 true，表示此层不具备作为结论的条件"
        }
      }
    },
    "WhyChainAnalysis": {
      "type": "object",
      "required": [
        "summary",
        "why_chain"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "description": "该维度根因的一句话总结"
        },
        "why_chain": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WhyChainStep"
          },
          "minItems": 1
        }
      }
    },
    "RAGSourceReference": {
      "type": "object",
      "required": [
        "doc_id",
        "doc_name"
      ],
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "doc_name": {
          "type": "string",
          "description": "人类可读的文档名称"
        },
        "similarity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "检索相似度分数"
        },
        "excerpt": {
          "type": "string",
          "description": "检索到的相关段落摘录"
        }
      }
    },
    "ContributingFactor": {
      "type": "object",
      "required": [
        "factor",
        "confidence"
      ],
      "properties": {
        "factor": {
          "type": "string",
          "description": "次要/辅助原因描述"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "confirmed",
            "inferred",
            "speculative"
          ]
        }
      }
    },
    "ExcludedCause": {
      "type": "object",
      "required": [
        "cause",
        "exclusion_reason"
      ],
      "properties": {
        "cause": {
          "type": "string",
          "description": "被排除的可能原因"
        },
        "exclusion_reason": {
          "type": "string",
          "description": "排除理由"
        },
        "exclusion_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        }
      }
    },
    "ConfirmationMeta": {
      "type": "object",
      "properties": {
        "is_confirmed": {
          "type": "boolean",
          "description": "该模块是否已被人工确认"
        },
        "confirmed_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "确认人 user_id，未确认时为 null"
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "确认时间 ISO8601，未确认时为 null"
        },
        "last_edited_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "最后编辑人 user_id"
        },
        "last_edited_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "最后编辑时间 ISO8601"
        }
      }
    },
    "TeamStructure": {
      "type": "object",
      "required": [
        "team_leader",
        "members",
        "departments_involved"
      ],
      "properties": {
        "team_leader": {
          "type": "string",
          "description": "组长姓名/工号"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "团队成员列表"
        },
        "departments_involved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "涉及部门"
        },
        "rationale": {
          "type": "string",
          "description": "组队理由（AI 生成时填充）"
        }
      }
    },
    "ContainmentAction": {
      "type": "object",
      "required": [
        "action",
        "owner",
        "deadline"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "具体围堵措施描述"
        },
        "owner": {
          "type": "string",
          "description": "负责人"
        },
        "deadline": {
          "type": "string",
          "description": "完成期限"
        },
        "rationale": {
          "type": "string",
          "description": "为什么要采取此措施"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "证据引用 ID 列表"
        }
      }
    },
    "AffectedScope": {
      "type": "object",
      "properties": {
        "batches_on_hold": {
          "type": "string",
          "description": "需要冻结/隔离的批次"
        },
        "inventory_check_required": {
          "type": "boolean",
          "description": "是否需要库存排查"
        },
        "customer_notification_required": {
          "type": "boolean",
          "description": "是否需要通知客户"
        }
      }
    },
    "CorrectiveAction": {
      "type": "object",
      "required": [
        "action",
        "target_root_cause",
        "owner",
        "deadline"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "具体纠正/永久措施描述"
        },
        "target_root_cause": {
          "type": "string",
          "description": "此措施针对的是 occurrence_cause 还是 escape_cause 中的哪条根因"
        },
        "owner": {
          "type": "string"
        },
        "deadline": {
          "type": "string"
        },
        "verification_method": {
          "type": "string",
          "description": "如何验证此措施有效"
        },
        "rationale": {
          "type": "string",
          "description": "选择此措施的理由"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "VerificationRecord": {
      "type": "object",
      "required": [
        "corrective_action_ref",
        "verification_method",
        "verification_criteria",
        "status"
      ],
      "properties": {
        "corrective_action_ref": {
          "type": "string",
          "description": "对应 D5 中的哪条措施（用措施的 action 文本或索引匹配）"
        },
        "verification_method": {
          "type": "string",
          "description": "验证方法"
        },
        "verification_criteria": {
          "type": "string",
          "description": "通过的判定标准"
        },
        "actual_result": {
          "type": [
            "string",
            "null"
          ],
          "description": "实际验证结果，AI 预填时留空，由人工填写"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed"
          ],
          "description": "验证状态"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PreventiveAction": {
      "type": "object",
      "required": [
        "action",
        "scope",
        "owner",
        "deadline"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "具体预防措施描述"
        },
        "scope": {
          "type": "string",
          "enum": [
            "流程改进",
            "标准更新",
            "培训",
            "系统防呆",
            "供应商管理",
            "检测加严",
            "其他"
          ],
          "description": "预防措施的类别"
        },
        "target_system": {
          "type": "string",
          "description": "影响的体系/流程名称"
        },
        "owner": {
          "type": "string"
        },
        "deadline": {
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "description": "此措施如何系统性防止再发"
        },
        "effectiveness_metric": {
          "type": "string",
          "description": "用什么指标衡量防再发效果"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RecognitionStructure": {
      "type": "object",
      "required": [
        "summary",
        "key_learnings",
        "closure_status"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "description": "整个 8D 过程的一句话总结"
        },
        "key_learnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "关键经验教训列表"
        },
        "team_contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "member",
              "contribution"
            ],
            "properties": {
              "member": {
                "type": "string"
              },
              "contribution": {
                "type": "string"
              }
            }
          },
          "description": "团队成员贡献记录"
        },
        "closure_status": {
          "type": "string",
          "enum": [
            "可结案",
            "需持续监控",
            "建议升级"
          ],
          "description": "结案判定"
        }
      }
    },
    "AuditEntry": {
      "type": "object",
      "required": [
        "timestamp",
        "user_id",
        "action",
        "target_field"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "user_id": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "step_confirmed",
            "field_edited",
            "ai_regenerated",
            "report_exported",
            "material_uploaded",
            "responsibility_changed"
          ]
        },
        "target_field": {
          "type": "string",
          "description": "修改的字段路径，如 D4.ai_analysis.occurrence_cause.summary"
        },
        "old_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "new_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "report_id",
        "tenant_id",
        "status",
        "current_step",
        "created_at",
        "created_by"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "format": "uuid",
          "description": "系统生成 UUID"
        },
        "tenant_id": {
          "type": "string",
          "description": "租户/公司标识"
        },
        "workspace_name": {
          "type": "string",
          "description": "显示用名称"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in_progress",
            "pending_review",
            "confirmed",
            "archived"
          ],
          "description": "报告整体生命周期状态"
        },
        "current_step": {
          "type": "string",
          "enum": [
            "step1_analysis",
            "step2_root_cause",
            "step3_responsibility",
            "step4_rendering"
          ],
          "description": "当前所处的分步确认阶段"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "description": "创建人 user_id"
        },
        "step_confirmations": {
          "type": "object",
          "properties": {
            "step1": {
              "type": "object",
              "properties": {
                "confirmed_by": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "confirmed_at": {
                  "oneOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "step2": {
              "type": "object",
              "properties": {
                "confirmed_by": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "confirmed_at": {
                  "oneOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "step3": {
              "type": "object",
              "properties": {
                "confirmed_by": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "confirmed_at": {
                  "oneOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "step4": {
              "type": "object",
              "properties": {
                "confirmed_by": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "confirmed_at": {
                  "oneOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "source_materials": {
      "type": "object",
      "description": "所有上传的原始资料索引",
      "properties": {
        "emails": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "file_name",
              "from",
              "to",
              "date",
              "subject",
              "body_text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "file_name": {
                "type": "string"
              },
              "from": {
                "type": "string",
                "description": "发件人"
              },
              "to": {
                "type": "string",
                "description": "收件人"
              },
              "date": {
                "type": "string",
                "format": "date-time"
              },
              "subject": {
                "type": "string"
              },
              "body_text": {
                "type": "string",
                "description": "提取后的纯文本正文"
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "附件文件 ID 引用列表"
              }
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "file_name",
              "uploaded_at",
              "vision_analysis"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "file_name": {
                "type": "string"
              },
              "uploaded_at": {
                "type": "string",
                "format": "date-time"
              },
              "vision_analysis": {
                "type": "object",
                "required": [
                  "defect_detected",
                  "severity",
                  "raw_description"
                ],
                "properties": {
                  "defect_detected": {
                    "type": "boolean"
                  },
                  "defect_type": {
                    "type": "string",
                    "enum": [
                      "破损",
                      "划痕",
                      "塌箱",
                      "变形",
                      "印刷缺陷",
                      "受潮",
                      "其他"
                    ],
                    "description": "Vision LLM 识别出的缺陷类型"
                  },
                  "defect_location": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "minor",
                      "moderate",
                      "major",
                      "critical"
                    ]
                  },
                  "raw_description": {
                    "type": "string",
                    "description": "Vision LLM 原始分析输出全文"
                  }
                }
              }
            }
          }
        },
        "supplementary_docs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "file_name",
              "doc_type",
              "uploaded_at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "file_name": {
                "type": "string"
              },
              "doc_type": {
                "type": "string",
                "enum": [
                  "coa_report",
                  "inspection_report",
                  "logistics_record",
                  "spec_sheet",
                  "sop",
                  "other"
                ]
              },
              "uploaded_at": {
                "type": "string",
                "format": "date-time"
              },
              "extracted_text": {
                "type": "string",
                "description": "关键段落提取文本"
              }
            }
          }
        }
      }
    },
    "D1_team": {
      "type": "object",
      "required": [
        "ai_draft",
        "is_confirmed"
      ],
      "description": "D1 — 组建问题解决团队",
      "properties": {
        "ai_draft": {
          "$ref": "#/definitions/TeamStructure"
        },
        "confirmed": {
          "oneOf": [
            {
              "$ref": "#/definitions/TeamStructure"
            },
            {
              "type": "null"
            }
          ],
          "description": "人工确认/修改后的终版，未确认时为 null"
        },
        "is_confirmed": {
          "type": "boolean"
        },
        "confirmed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_edited_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_edited_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "D2_problem_description": {
      "type": "object",
      "required": [
        "ai_5w2h",
        "supplementary_checklist",
        "is_confirmed"
      ],
      "description": "D2 — 问题描述 (5W2H) 与影响范围",
      "properties": {
        "ai_5w2h": {
          "type": "object",
          "required": [
            "what",
            "who",
            "when",
            "where",
            "how",
            "how_much"
          ],
          "properties": {
            "what": {
              "type": "object",
              "required": [
                "defect_name",
                "defect_category",
                "detailed_description"
              ],
              "properties": {
                "defect_name": {
                  "type": "string"
                },
                "defect_category": {
                  "type": "string"
                },
                "detailed_description": {
                  "type": "string"
                },
                "evidence": {
